{
  "name": "bizmo",
  "displayName": "Bizmo — Business Process Modeler",
  "description": "Bizmo: secure business process modeling in VS Code — BPMN (Camunda 7 and 8), DMN, Camunda Forms, Value Stream Mapping, SIPOC, Event Storming, and UML.",
  "version": "1.1.0",
  "publisher": "21010",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/21010/bizmo.git"
  },
  "bugs": {
    "url": "https://github.com/21010/bizmo/issues"
  },
  "homepage": "https://github.com/21010/bizmo#readme",
  "private": true,
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "bizmo",
    "bpmn",
    "camunda",
    "dmn",
    "forms",
    "value stream mapping",
    "lean",
    "sipoc",
    "event storming",
    "uml",
    "process modeling"
  ],
  "main": "./dist/extension/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Viewing and editing diagrams works in restricted mode. Loading element templates and other workspace configuration requires trust."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "bizmo.bpmn",
        "displayName": "Bizmo BPMN Modeler",
        "selector": [
          {
            "filenamePattern": "*.bpmn"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "bizmo.dmn",
        "displayName": "Bizmo DMN Modeler",
        "selector": [
          {
            "filenamePattern": "*.dmn"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "bizmo.showLog",
        "title": "Show Log",
        "category": "Bizmo"
      },
      {
        "command": "bizmo.bpmn.openAsText",
        "title": "Open as Text",
        "category": "Bizmo",
        "icon": "$(go-to-file)"
      },
      {
        "command": "bizmo.bpmn.openDiagram",
        "title": "Open Diagram",
        "category": "Bizmo",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "bizmo.bpmn.newDiagramC8",
        "title": "New BPMN Diagram (Camunda 8)",
        "category": "Bizmo",
        "shortTitle": "BPMN Diagram (Camunda 8)"
      },
      {
        "command": "bizmo.bpmn.newDiagramC7",
        "title": "New BPMN Diagram (Camunda 7)",
        "category": "Bizmo",
        "shortTitle": "BPMN Diagram (Camunda 7)"
      },
      {
        "command": "bizmo.bpmn.showProblem",
        "title": "Show Problem in Diagram",
        "category": "Bizmo"
      },
      {
        "command": "bizmo.bpmn.exportSvg",
        "title": "Export as SVG…",
        "category": "Bizmo"
      },
      {
        "command": "bizmo.bpmn.exportPng",
        "title": "Export as PNG…",
        "category": "Bizmo"
      },
      {
        "command": "bizmo.dmn.openAsText",
        "title": "Open as Text",
        "category": "Bizmo",
        "icon": "$(go-to-file)"
      },
      {
        "command": "bizmo.dmn.openDiagram",
        "title": "Open Diagram",
        "category": "Bizmo",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "bizmo.dmn.newDiagramC8",
        "title": "New DMN Diagram (Camunda 8)",
        "category": "Bizmo",
        "shortTitle": "DMN Diagram (Camunda 8)"
      },
      {
        "command": "bizmo.dmn.newDiagramC7",
        "title": "New DMN Diagram (Camunda 7)",
        "category": "Bizmo",
        "shortTitle": "DMN Diagram (Camunda 7)"
      },
      {
        "command": "bizmo.dmn.exportSvg",
        "title": "Export as SVG…",
        "category": "Bizmo"
      },
      {
        "command": "bizmo.dmn.exportPng",
        "title": "Export as PNG…",
        "category": "Bizmo"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bizmo.bpmn.openAsText",
          "when": "activeCustomEditorId == bizmo.bpmn",
          "group": "navigation"
        },
        {
          "command": "bizmo.bpmn.openDiagram",
          "when": "resourceExtname == .bpmn && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "bizmo.bpmn.exportSvg",
          "when": "activeCustomEditorId == bizmo.bpmn",
          "group": "1_export"
        },
        {
          "command": "bizmo.bpmn.exportPng",
          "when": "activeCustomEditorId == bizmo.bpmn",
          "group": "1_export"
        },
        {
          "command": "bizmo.dmn.openAsText",
          "when": "activeCustomEditorId == bizmo.dmn",
          "group": "navigation"
        },
        {
          "command": "bizmo.dmn.openDiagram",
          "when": "resourceExtname == .dmn && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "bizmo.dmn.exportSvg",
          "when": "activeCustomEditorId == bizmo.dmn",
          "group": "1_export"
        },
        {
          "command": "bizmo.dmn.exportPng",
          "when": "activeCustomEditorId == bizmo.dmn",
          "group": "1_export"
        }
      ],
      "explorer/context": [
        {
          "command": "bizmo.bpmn.openAsText",
          "when": "resourceExtname == .bpmn",
          "group": "navigation@20"
        },
        {
          "command": "bizmo.bpmn.openDiagram",
          "when": "resourceExtname == .bpmn",
          "group": "navigation@21"
        },
        {
          "command": "bizmo.dmn.openAsText",
          "when": "resourceExtname == .dmn",
          "group": "navigation@20"
        },
        {
          "command": "bizmo.dmn.openDiagram",
          "when": "resourceExtname == .dmn",
          "group": "navigation@21"
        }
      ],
      "commandPalette": [
        {
          "command": "bizmo.bpmn.openAsText",
          "when": "activeCustomEditorId == bizmo.bpmn"
        },
        {
          "command": "bizmo.bpmn.openDiagram",
          "when": "resourceExtname == .bpmn && activeEditor == workbench.editors.files.textFileEditor"
        },
        {
          "command": "bizmo.bpmn.showProblem",
          "when": "false"
        },
        {
          "command": "bizmo.bpmn.exportSvg",
          "when": "activeCustomEditorId == bizmo.bpmn"
        },
        {
          "command": "bizmo.bpmn.exportPng",
          "when": "activeCustomEditorId == bizmo.bpmn"
        },
        {
          "command": "bizmo.dmn.openAsText",
          "when": "activeCustomEditorId == bizmo.dmn"
        },
        {
          "command": "bizmo.dmn.openDiagram",
          "when": "resourceExtname == .dmn && activeEditor == workbench.editors.files.textFileEditor"
        },
        {
          "command": "bizmo.dmn.exportSvg",
          "when": "activeCustomEditorId == bizmo.dmn"
        },
        {
          "command": "bizmo.dmn.exportPng",
          "when": "activeCustomEditorId == bizmo.dmn"
        }
      ],
      "file/newFile": [
        {
          "command": "bizmo.bpmn.newDiagramC8",
          "group": "bpmn"
        },
        {
          "command": "bizmo.bpmn.newDiagramC7",
          "group": "bpmn"
        },
        {
          "command": "bizmo.dmn.newDiagramC8",
          "group": "dmn"
        },
        {
          "command": "bizmo.dmn.newDiagramC7",
          "group": "dmn"
        }
      ]
    },
    "configuration": {
      "title": "Bizmo",
      "properties": {
        "bizmo.maxFileSizeMB": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 200,
          "markdownDescription": "Largest model file (in MB) that Bizmo renders. Larger files can still be opened as text."
        },
        "bizmo.bpmn.linting.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Check BPMN diagrams with the Camunda linter (as in Camunda Modeler) and show problems on the diagram and in the **Problems** view. Uses the diagram's execution platform and version."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --production",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.extension.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "pretest:integration": "npm run build && node scripts/build-tests.mjs",
    "test:integration": "vscode-test",
    "package": "vsce package --no-dependencies",
    "check:vsix": "node scripts/check-vsix.mjs",
    "vscode:prepublish": "npm run build:prod",
    "pretest:webview": "npm run build",
    "test:webview": "vitest run --config vitest.webview.config.mts",
    "notices": "node scripts/notices.mjs",
    "check:notices": "node scripts/notices.mjs --check",
    "pretest:e2e": "npm run build",
    "test:e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.134.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "bpmn-moddle": "10.3.1",
    "camunda-dmn-moddle": "1.3.1",
    "dmn-moddle": "12.2.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "saxen": "11.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "zeebe-dmn-moddle": "1.0.0"
  },
  "overrides": {
    "diff": "9.0.0",
    "serialize-javascript": "7.1.2"
  },
  "dependencies": {
    "@bpmn-io/dmn-migrate": "0.7.1",
    "@camunda/linting": "4.1.0",
    "bpmn-js": "18.31.0",
    "bpmn-js-properties-panel": "5.65.1",
    "camunda-bpmn-js": "5.36.0",
    "camunda-dmn-js": "3.8.3",
    "diagram-js": "15.28.0",
    "dmn-js-properties-panel": "3.12.0"
  }
}
